# Congestion control algorithms under test
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_LGCC=y
CONFIG_TCP_CONG_LGC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_DCTCP=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_RENO=y

# Queue disciplines required
CONFIG_NET_SCH_RED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_CLS_U32=y

# PEP-DNA: TPROXY, connection tracking, and NAT rules
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y

# PEP-specific iptables and NAT features
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_TARGET_TPROXY=y
CONFIG_IP_NF_MANGLE=y

# Required for multi-routing and ip rule management
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
